// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NextAuth User model
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  clerkId       String?
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(PATIENT)
  plan          PlanType  @default(FREE)
  orgId         String?   @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  patient        Patient?
  doctor         Doctor?
  admin          Admin?
  organization   Organization?  @relation(fields: [orgId], references: [id])
  transactions   Transaction[]
  journalEntries JournalEntry[]
  notifications  Notification[]
  conversations  Conversation[]
  assessmentAttempts AssessmentAttempt[]
  memoryGraph UserMemoryGraph?
  activityLogs UserActivityLog[]
  moodEntries MoodEntry[]
  supportMessages SupportMessage[]
  referralCode ReferralCode?
 
  @@map("users")
}


model Organization {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  domains        String[]
  planType       PlanType @default(ORGANIZATION)
  aiLimit        Int?
  journalingType String?
  goalType       String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  sessionLimit   Int? // Global limit on sessions for the institution
  studentLimit   Int? // Global limit on students for the institution
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  batches         Batch[]
  departments     Department[]
  assignedDoctors OrganizationDoctor[]

  @@map("organizations")
}

model Batch {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  name           String // e.g., "2025 B.Tech CSE"
  graduationYear Int?
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients     Patient[]

  @@map("batches")
}

model Department {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String // e.g., "CSE", "ECE"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients     Patient[]

  @@map("departments")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  INSTITUTION_ADMIN
}

enum PlanType {
  FREE
  ESSENTIAL
  PREMIUM
  ORGANIZATION
}

// Patient Model
model Patient {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @unique @db.ObjectId
  age                   Int?
  dob                   String?
  gender                String?
  healthConcerns        String[] @default([])
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?
  preferredLanguage     String?  @default("English")

  // Institution fields
  batchId       String? @db.ObjectId
  departmentId  String? @db.ObjectId
  rollNumber    String?
  studentStatus String  @default("ACTIVE") // ACTIVE, SUSPENDED, GRADUATED

  // AI Onboarding fields
  aiNickname   String?
  heardAboutUs String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  batch        Batch?        @relation(fields: [batchId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])

  // Gamification
  currentStreak Int       @default(0)
  lastLoginDate DateTime?
  totalCredits  Int       @default(0)

  @@map("patients")
}

// Doctor Model
model Doctor {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  // Personal Information (Section 1)
  fullName       String? // Full name as per license
  profilePhoto   String? // URL to uploaded photo
  gender         String?
  dateOfBirth    DateTime?
  mobileNumber   String?
  mobileVerified Boolean   @default(false)
  mobileOTP      String?
  emailAddress   String? // Already in User model, but keeping for reference
  currentAddress String?   @db.String
  city           String?
  state          String?
  country        String?   @default("India")

  // Professional Verification (Section 2)
  licenseNumber            String?
  issuingCouncil           String? // MCI/NMC, State Medical Council
  licenseDocument          String? // URL to uploaded license document
  digiLockerId             String?
  digiLockerVerified       Boolean  @default(false)
  yearsOfExperience        Int?
  primarySpecialization    String?
  secondarySpecializations String[] @default([]) // Array of specializations
  highestQualification     String?
  degreeCertificates       String[] @default([]) // URLs to uploaded certificates
  bio                      String?  @db.String // Professional bio (150-500 words)

  // Practice Details (Section 3)
  languagesSpoken    String[] @default([])
  preferredAgeGroups String[] @default([]) // Kids, Teens, Adults, Seniors
  consultationTypes  String[] @default([]) // Video, Chat, Voice, In-person
  notAcceptingCases  String[] @default([]) // Emergency/crisis, controlled substances, etc.

  // Availability & Scheduling (Section 4) - Handled by DoctorAvailability model
  appointmentDuration Int? @default(45) // in minutes
  slotBuffer          Int? @default(15) // in minutes

  // Payment Details (Section 5)
  consultationFee   Float   @default(0)
  payoutMode        String? // UPI or BANK
  paymentUPI        String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIFSC          String?
  bankName          String?

  // Compliance & Legal (Section 6)
  telemedicineConsent Boolean @default(false)
  privacyAgreement    Boolean @default(false)
  dataSharingPolicy   Boolean @default(false)
  platformTerms       Boolean @default(false)
  declarationSigned   Boolean @default(false)
  digitalSignature    String? // Full name typed for digital signature

  // Status and Relations
  specialization  String? // Keeping for backward compatibility
  experience      Int? // Keeping for backward compatibility
  licenseVerified Boolean      @default(false)
  status          DoctorStatus @default(PENDING_PROFILE)

  // KYC & Documents
  aadhaarDocument         String?
  panDocument             String?
  panNumber               String?
  cancelledChequeDocument String?
  razorpayAccountId       String?
  paymentsEnabled         Boolean @default(false)
  payoutStatus            String  @default("PENDING")

  availability DoctorAvailability?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  timeSlots     TimeSlot[]
  organizations OrganizationDoctor[]

  @@map("doctors")
}

// Join table for Doctors and Organizations
model OrganizationDoctor {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String   @db.ObjectId
  doctorId        String   @db.ObjectId
  assignedByAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, doctorId])
  @@map("organization_doctors")
}

enum DoctorStatus {
  PENDING_PROFILE
  PENDING_DOCUMENTS
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

// Doctor Availability
model DoctorAvailability {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId      String   @unique @db.ObjectId
  availableDays String[] // ["MONDAY", "TUESDAY", etc.]
  startTime     String? // "09:00"
  endTime       String? // "17:00"
  breaks        Json? // Array of break times
  isAvailable   Boolean  @default(true) // Toggle to stop accepting appointments
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_availability")
}

// Time Slots for appointments
model TimeSlot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String   @db.ObjectId
  date      DateTime
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@map("time_slots")
}

// Admin Model
model Admin {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  phoneNumber String?
  otpEnabled  Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// Appointment Model
model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String?           @db.ObjectId
  doctorId        String            @db.ObjectId
  timeSlotId      String?           @unique @db.ObjectId
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING)
  meetingLink     String?
  chatChannelId   String?
  doctorNotes     String?           @db.String
  patientRating   Int? // 1 to 5 stars
  patientFeedback String?           @db.String
  actualDuration  Int? // in minutes
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient  Patient?          @relation(fields: [patientId], references: [id])
  doctor   Doctor            @relation(fields: [doctorId], references: [id])
  timeSlot TimeSlot?         @relation(fields: [timeSlotId], references: [id])
  payment  Payment?
  session  SessionRecording?

  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Payment Model
model Payment {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId     String           @unique @db.ObjectId
  amount            Float
  platformFee       Float
  doctorAmount      Float
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus    @default(PENDING)
  paymentMethod     String?
  settlementStatus  SettlementStatus @default(PENDING)
  settledAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
}

enum Platform {
  WEB
  IOS
  ANDROID
}

enum GuestStatus {
  ACTIVE
  CLAIMED
  EXPIRED
  LOCKED
  DELETED
}

enum ConversationStatus {
  ACTIVE
  EXPIRED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model GuestSession {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken  String      @unique
  platform      Platform    @default(WEB)
  status        GuestStatus @default(ACTIVE)
  trialConsumed Boolean     @default(false)
  expiresAt     DateTime
  consumedAt    DateTime?
  claimedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  conversations Conversation[]

  @@map("guest_sessions")
}

model Conversation {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?            @db.ObjectId
  guestSessionId String?            @db.ObjectId
  title          String?
  platform       Platform           @default(WEB)
  status         ConversationStatus @default(ACTIVE)
  expiresAt      DateTime?
  claimedAt      DateTime?
  lastMessageAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([userId])
  @@index([guestSessionId])
  @@index([userId, status, updatedAt])
  @@index([guestSessionId, status, updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String      @db.ObjectId
  role           MessageRole
  content        String      @db.String
  action         Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Session Recording (Video/Chat)
model SessionRecording {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String    @unique @db.ObjectId
  recordingUrl  String?
  transcriptUrl String?
  transcript    String?   @db.String
  duration      Int? // in seconds
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("session_recordings")
}

// Transaction Model for Top-ups and generalized payments
model Transaction {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String // e.g., "CREDIT_TOPUP", "SUBSCRIPTION"
  amount            Float
  status            String // e.g., "SUCCESS", "FAILED"
  description       String
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// Journal Entry
model JournalEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String? // Optional title for the journal entry
  content   String   @db.String
  moodScore Int? // e.g., 1-5 or 1-10 scale
  tags      String[] @default([]) // Keywords or themes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

// Notifications (Admin Notes, System Alerts, etc.)
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  message   String   @db.String
  type      String   @default("ADMIN_NOTE") // e.g., ADMIN_NOTE, APPOINTMENT, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model LoginOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otp       String
  createdAt DateTime @default(now())

  @@map("login_otps")
}
model PatientAssessmentResult {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  assessmentId String
  date         String
  results      Json
  createdAt    DateTime @default(now())

  @@map("patient_assessment_results")
}

enum WellnessActivityCategory {
  BREATHING
  GROUNDING
  RELAXATION
  JOURNALING
  SLEEP
}

model WellnessActivity {
  id                String                   @id @default(auto()) @map("_id") @db.ObjectId
  slug              String                   @unique
  category          WellnessActivityCategory
  title             String
  shortDescription  String
  benefits          String                   @db.String
  instructions      String[]
  estimatedDuration String
  audioUrl          String?
  displayOrder      Int
  phase             Int                      @default(1)
  isAvailable       Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  userLogs          UserActivityLog[]

  @@map("wellness_activities")
}


model AssessmentAttempt {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  assessmentKey String
  status        AttemptStatus
  score         Int?
  severity      String?
  interpretation String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  user User @relation(fields:[userId], references:[id])
  responses AssessmentResponse[]
  @@index([userId])
  @@index([assessmentKey])
  @@map("assessment_attempts")
}

enum AttemptStatus{
    COMPLETED
    INCOMPLETE
}

model AssessmentResponse {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  attemptId String @db.ObjectId
  questionId String
  selectedValue Int
  createdAt DateTime @default(now())
  attempt AssessmentAttempt @relation(fields:[attemptId], references:[id])
  @@index([attemptId])
  @@map("assessment_responses")
}


model AudioTrack {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  category    String
  audioUrl    String
  imageUrl    String?
  duration    Int?      // seconds
  isPremium   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("audio_tracks")
}

model UserMemoryGraph {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId

  // 6 Clinical Memory Modules — stored as native MongoDB JSON
  personal         Json     @default("{}")
  clinical         Json     @default("[]")
  relational       Json     @default("[]")
  behavioral       Json     @default("{}")
  wellness         Json     @default("{}")
  sessionSummary   Json     @default("{}")

  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_memory_graphs")
}

model UserActivityLog {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  wellnessActivityId String   @db.ObjectId
  durationMs         Int?     // session duration in ms
  timestamp          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wellnessActivity WellnessActivity @relation(fields: [wellnessActivityId], references: [id])

  @@map("user_activity_logs")
}

model MoodEntry {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  mood             String   // e.g., "Happy", "Sad"
  moodScore        Int?     // 1-10 intensity
  note             String?  @db.String
  tags             String[] @default([])
  energyLevel      Int?     // 1-10
  stressLevel      Int?     // 1-10
  sleepQuality     Int?     // 1-10
  craving          Boolean  @default(false)
  cravingIntensity Int?
  cravingTrigger   String[] @default([])
  timestamp        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mood_entries")
}

model SupportMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  userName  String?
  userEmail String?
  message   String   @db.String
  status    String   @default("new")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@index([userId])
  @@index([status])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("support_messages")
}

// Referral System
model ReferralCode {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @unique @db.ObjectId
  code          String    @unique
  rewardClaimed Boolean   @default(false)
  claimAddress  String?
  claimPhone    String?
  claimSize     String?
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@map("referral_codes")
}

model Referral {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  referralCodeId String   @db.ObjectId
  inviteeName    String
  status         String   @default("PENDING") // PENDING | JOINED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@map("referrals")
}
